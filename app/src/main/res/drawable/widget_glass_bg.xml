<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews cannot host a RenderEffect, so the widget glass is a two layer
     drawable: a dark scrim for contrast plus a diagonal white sheen and a 1dp
     specular border. No bitmaps, a few hundred bytes of XML. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <solid android:color="#330A0E14" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:angle="315"
                android:centerColor="#1FFFFFFF"
                android:endColor="#26FFFFFF"
                android:startColor="#4DFFFFFF"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>

</layer-list>
